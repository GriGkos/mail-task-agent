APP_ENV=development
APP_TIMEZONE=Europe/Amsterdam
LOG_LEVEL=INFO
APP_BASE_URL=http://localhost:8000
APP_DOMAIN=localhost

DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/email_agent
TOKEN_ENCRYPTION_KEY=

MAIL_PROVIDER=gmail

LLM_PROVIDER=deepseek

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=60

OPENMODEL_API_KEY=
OPENMODEL_BASE_URL=https://api.openmodel.ai
OPENMODEL_MODEL=deepseek-v4-flash
OPENMODEL_TIMEOUT_SECONDS=60
OPENMODEL_MAX_TOKENS=2048

GOOGLE_CLIENT_SECRET_FILE=/app/secrets/google_client_secret.json
GOOGLE_TOKEN_FILE=/app/secrets/google_token.json
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/gmail.modify
GMAIL_QUERY=label:AI_TEST -label:AI/Processed
# Used only when a user switches Telegram settings to label mode.
GMAIL_POLL_INTERVAL_SECONDS=120
GMAIL_BATCH_SIZE=25

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_TOKEN_CACHE_FILE=/app/secrets/ms_token_cache.bin
MICROSOFT_SCOPES=User.Read Mail.ReadWrite offline_access
MICROSOFT_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
OUTLOOK_CATEGORY=AI_TEST
OUTLOOK_TASK_CATEGORY=AI_Task
OUTLOOK_WAITING_CATEGORY=AI_Waiting
OUTLOOK_REVIEW_CATEGORY=AI_Review
OUTLOOK_INFO_CATEGORY=AI_Info
OUTLOOK_PROCESSED_CATEGORY=AI_Processed
OUTLOOK_ERROR_CATEGORY=AI_Error
OUTLOOK_POLL_INTERVAL_SECONDS=120

# Universal IMAP accounts are configured by users through Telegram.
IMAP_POLL_INTERVAL_SECONDS=120
IMAP_BATCH_SIZE=25
IMAP_DEFAULT_FOLDER=INBOX

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
TELEGRAM_API_IP=149.154.167.220

ADMIN_API_KEY=

SAFE_MODE=true
DRY_RUN=true
STORE_EMAIL_BODY=false

AUTO_ACTION_CONFIDENCE=0.90
REVIEW_CONFIDENCE=0.70

MAX_EMAIL_CHARS=20000
MAX_THREAD_MESSAGES=5

DAILY_DIGEST_ENABLED=true
DAILY_DIGEST_TIME=08:30
STALE_TASK_DAYS=7
